APP_NAME=hybridlog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Every host the app answers to, comma separated; anything else gets a 403.
# Required as soon as the app is publicly reachable (the platform's hostname,
# your own domain), otherwise a forged Host header poisons the OAuth
# discovery metadata.
# Note: only enforced when APP_ENV is not "local".
TRUSTED_HOSTS=

# Whatever terminates TLS in front of the app, comma separated. Only what is
# named here may set X-Forwarded-Proto, and without it Laravel builds http://
# links behind an https:// front door: OAuth redirects no client accepts, a
# session cookie that never gets the Secure flag. The default is loopback,
# where a proxy on the same machine sits. On a managed platform the router
# sits at an address that changes with every deploy and is the only way in at
# all, so "*" is the honest answer there.
TRUSTED_PROXIES=127.0.0.1,::1

# The athlete's calendar. Garmin dates its days in the watch's local time and
# every window this dashboard computes is a day or a week in that same one, so
# this is the zone the whole app runs on, not UTC. The Python fetcher reads the
# same variable and stamps fetch_log with it: a container left on UTC while the
# app reads Berlin dates every fetch two hours early in the header.
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Only honoured by "php artisan serve --no-reload". With the default file
# watcher active, artisan serve keeps a single server and ignores this
# variable, so one slow MCP call blocks the dashboard page. The trade-off of
# --no-reload: .env edits no longer restart the server.
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# One PostgreSQL database holds everything: the app's own tables in schema
# "public", one Garmin mirror per athlete in "garmin_t{their user id}", and
# the Garmin sessions in "garmin_private". Create it once with createdb,
# then run database/postgres/roles.sql if you want the privilege split
# below. The mirrors themselves are made when an athlete first needs one.
DB_CONNECTION=pgsql
# A single URL is what every managed platform hands out, and it wins over the
# four variables under it. Leave it empty to configure them by hand. Empty
# also falls back to DATABASE_URL further down, which is the name the platform
# uses when it provisions a database for you, so on a one-role installation
# setting that one variable points everything here at it.
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=garmin
# Empty means "let libpq decide", which on a local install is your operating
# system account. That is enough to get started; the roles below are for a
# deployment that is reachable from outside.
DB_USERNAME=
DB_PASSWORD=
# "require" as soon as the database is not on the same machine.
DB_SSLMODE=prefer

# How the dashboard reads the mirrors. Unset, it uses the credentials above,
# which is fine locally and for a demo. Point it at the garmin_reader role
# from database/postgres/roles.sql and SQL written by the language model can
# physically not reach the users table or the OAuth tokens, whatever it asks
# for. Same database, fewer rights. Empty falls back to DB_URL and then to
# DATABASE_URL, so where there is only one role there is nothing to set.
#
# Whichever role it is, the app switches out of it before every read: into
# garmin_reader_t{id}, which holds one athlete's schema and nothing else.
# That is what keeps two athletes apart even where the connection string is
# a superuser's, which on a managed platform it usually is.
GARMIN_DB_URL=
# GARMIN_DB_USERNAME=garmin_reader
# GARMIN_DB_PASSWORD=

# How far back the first fetch of a newly connected athlete reaches. Ninety
# days is what the dashboard opens on and about what the load models need
# before they mean anything; the run takes roughly a quarter of an hour and
# happens on the queue, so nobody waits for it.
# GARMIN_FIRST_CONNECT_DAYS=90

# How the fetcher writes it (fetcher/fetch.py, fetcher/seed_demo.py). The
# writing role, again from roles.sql. Falls back to DATABASE_URL, which is
# what a platform sets for you, so on a one-role installation you can leave
# this empty and set DATABASE_URL instead.
GARMIN_FETCH_DSN=
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/garmin

# What an athlete's reader role is called, before their user id. Leave it
# alone: it exists because Postgres roles belong to the whole cluster where
# schemas belong to one database, so a test database living beside a real
# one shares these names with it. The suite therefore takes a prefix of its
# own (phpunit.xml) and a deployment never needs to.
# GARMIN_READER_ROLE_PREFIX=garmin_reader_t

# The athlete's own profile (sex, birth year) is not configured here. It is
# entered in the dashboard under "Profil" and stored in the database, where
# it belongs to the athlete rather than to the deployment.

# Where the weather is mirrored from, in decimal degrees. The one thing
# this installation sends to a third party, so it has no default: leave
# both empty and no weather is fetched, no request is made and the
# dashboard simply shows nothing about it.
#
# With them set, fetch.py pulls hourly conditions from Open-Meteo (free,
# no key, non-commercial use, 10.000 calls a day) and backfills every day
# the mirror already holds on its first run. A run spends one or two of
# those calls whatever the range, so three fetches a day cost about six.
# Open-Meteo receives the coordinates and a date range, nothing else: no
# health data, no account, no session.
#
# It buys the half of an explanation Garmin never hands over. Deep sleep
# collapses on muggy nights, heart rate drifts upward in heat and the same
# session then reads as fatigue, and the hydration goal moves with weather
# the dashboard could not show. The location is the home one, not per
# session: the nights are where most of the signal is, and Garmin's
# activity coordinates are not mirrored at all.
#
# This pair is the installation's location and the fallback for everybody
# on it. An athlete who names a town on their profile page is fetched at
# theirs instead, which is what lets two athletes on one installation have
# two skies. Leave it set: it stays right for whoever set it up.
#
# Example (Berlin): WEATHER_LAT=52.5200 / WEATHER_LON=13.4050
WEATHER_LAT=
WEATHER_LON=

# A fetch is dispatched onto the queue and Laravel's scheduler holds the
# times, so the installation needs a running worker ("php artisan queue:work")
# and a scheduler ("php artisan schedule:work"). Without them the refresh
# button enqueues a fetch that nothing ever runs.
#
# How to run the fetcher. Empty uses fetcher/venv/bin/python, the virtualenv
# the README sets up. An image with the requirements installed system-wide
# sets "python3 /app/fetcher/fetch.py" here.
GARMIN_FETCH_COMMAND=
# Seconds before a running fetch is killed. Sized by the slowest run that
# is still healthy: the first fetch after connecting Garmin walks ninety
# days at fourteen throttled calls each and needs twenty minutes and more,
# and 900 here killed exactly that run. A regular run takes about a minute
# and never feels this ceiling.
GARMIN_FETCH_TIMEOUT=2700
# When the scheduler fetches, comma separated, in the app's timezone.
GARMIN_FETCH_TIMES=09:30,13:00,21:00
#
# The sign-in behind /connect/garmin. Empty runs fetcher/login.py with
# whatever interpreter the fetch command uses, which is right unless the two
# scripts live apart. The whole sign-in happens inside one worker process,
# because Garmin only asks for the MFA code once the password is accepted
# and the half-open session cannot be handed to a second process; the
# timeouts below are what that process is allowed to spend waiting.
GARMIN_LOGIN_COMMAND=
# Total seconds before the sign-in is killed.
GARMIN_LOGIN_TIMEOUT=600
# Seconds to wait for Garmin to answer one step of it.
GARMIN_LOGIN_STEP_TIMEOUT=120
# Seconds the sign-in holds open while the athlete looks up the MFA code.
GARMIN_LOGIN_MFA_TIMEOUT=300

# Executable that delivers a health alert (app:health-alerts), called with the
# message as its single argument. Anything works that takes one argument: a
# notification script, a webhook wrapper, a mail one-liner. Empty means the
# rules still run and log, they just deliver nowhere.
GARMIN_ALERT_COMMAND=

# Web push: the morning briefing, the health alerts, the bedtime nudge and
# the weekly reminder. Off until this installation has a key pair of its
# own, which "php artisan push:keys" prints. There is no shared pair,
# because the public half is the identity every browser subscription here is
# bound to; replacing it unsubscribes every device that already agreed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service can complain about this sender, as RFC 8292 asks for.
# A mailto: or https: address, seen by the push service and by nobody else.
VAPID_SUBJECT=mailto:admin@localhost

# Demo mode, for one thing only: a public shop-window copy of this
# dashboard whose password is written next to it, the way demo instances
# of self-hosted projects usually are. Leave it off on your own
# installation, where it would take away things you want.
#
# It closes every surface that would reach out of the installation on
# behalf of the account everybody is sharing: signing in to Garmin (the
# important one, because nobody should type their real watch password
# into a dashboard a stranger put up), the AI connector and its OAuth
# registration, notifications, and the Fetch from Garmin button. Reading
# stays open, and so do the symptom log and the language switch, which
# are part of what there is to try and are wiped overnight anyway.
#
# `php artisan demo:reset` is what wipes them: it puts the account below
# back, deletes what visitors left behind and reseeds the mirror from
# fetcher/seed_demo.py. With DEMO_MODE on, the scheduler runs it nightly
# by itself; the first time, before the switch is thrown, run it once
# with --force.
DEMO_MODE=false
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-demo-demo
# How the reset runs the seed. Empty derives it from GARMIN_FETCH_COMMAND
# above, one script over, which is right unless the two live apart.
DEMO_SEED_COMMAND=

# Visitor counting, for a copy of this dashboard that is a shop window: the
# script tag of an Umami instance you host yourself, which counts page views
# without a cookie and without an identifier that follows anyone off the
# site. Both lines have to be filled for anything to be rendered; empty, the
# default, means no third-party script in any page and no request to any
# host but this one. Independent of DEMO_MODE, because the decision is
# yours. The first is the full URL of the tracker script, the second the
# site id your Umami hands out when the site is added there.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true whenever the app is served over HTTPS, which is any hosted install.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
